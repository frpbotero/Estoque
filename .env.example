# ---------------------------------------------------------------------------
# Banco de dados
# ---------------------------------------------------------------------------
POSTGRES_USER=warehouse
POSTGRES_PASSWORD=warehouse
POSTGRES_DB=ti_warehouse
POSTGRES_PORT=5432

# String usada pelo Prisma dentro do container do backend
DATABASE_URL=postgresql://warehouse:warehouse@postgres:5432/ti_warehouse?schema=public

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
NODE_ENV=development
API_PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:4200

JWT_ACCESS_SECRET=troque-este-segredo-de-access-token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=troque-este-segredo-de-refresh-token
JWT_REFRESH_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Bootstrap do administrador (idempotente: nunca duplica)
# ---------------------------------------------------------------------------
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=change-me

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
WEB_PORT=4200
